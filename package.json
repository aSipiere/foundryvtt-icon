{
  "description": "Provides a bare-bones Foundry module template repo to get set up with using the TyphonJS Runtime Library and Svelte with ES Modules.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "author": "WHITESPINE",
  "contributors": [
    "Michael Leahy <support@typhonjs.io> (https://github.com/typhonrt)"
  ],
  "imports": {
    "#runtime/*": "@typhonjs-fvtt/runtime/*",
    "#standard/*": "@typhonjs-fvtt/standard/*"
  },
  "dependencies": {
    "@typhonjs-fvtt/runtime": "^0.2.0",
    "@typhonjs-fvtt/standard": "^0.2.0",
    "svelte": "^4.0.0"
  },
  "devDependencies": {
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@typhonjs-config/eslint-config": "^0.6.0",
    "@typhonjs-fvtt/eslint-config-foundry.js": "^0.8.0",
    "eslint": "^8",
    "sass": "^1.63.6",
    "svelte-preprocess": "^6",
    "vite": "^5.0.0",
    "vitest": "^4.0.18"
  },
  "browserslist": [
    ">5%",
    "not IE 11"
  ],
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "eslint": "eslint .",
    "fixlint": "eslint . --fix",
    "test": "vitest run"
  }
